{
  "expo": {
    "name": "Forma",
    "slug": "forma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/logo_black.png",
    "scheme": "forma",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0C",
    "ios": {
      "bundleIdentifier": "ru.formaone.app",
      "icon": {
        "light": "./assets/branding/logo_yellow.png",
        "dark": "./assets/branding/logo_black.png",
        "tinted": "./assets/branding/logo_black.png"
      },
      "infoPlist": {
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "ru.formaone.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/branding/android-icon-foreground.png",
        "backgroundImage": "./assets/branding/android-icon-background.png",
        "monochromeImage": "./assets/branding/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc0d1c1b-b021-4a4b-a6db-cf87593487a0"
      }
    },
    "owner": "wazzupjohnny"
  }
}
