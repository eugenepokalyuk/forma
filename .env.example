# Прод по умолчанию (см. src/shared/api/getApiBase.ts). Для локальной разработки с
# устройства — LAN-IP бэкенда, не localhost (телефон не видит localhost хоста).
EXPO_PUBLIC_API_URL=http://<LAN-IP>:8000/api/v1

# Sentry — сбор падений. Пусто — сбор выключен. DSN: Sentry → Project
# Settings → Client Keys. Для EAS-сборок задаётся в переменных окружения EAS.
EXPO_PUBLIC_SENTRY_DSN=
